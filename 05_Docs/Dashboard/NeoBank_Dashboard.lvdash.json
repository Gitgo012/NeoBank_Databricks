{
  "datasets": [
    {
      "name": "231687a2",
      "displayName": "Total Customers",
      "queryLines": [
        "select count(distinct customer_id) as total_customers from banking.gold.customer_360;"
      ]
    },
    {
      "name": "ffb7de95",
      "displayName": "Total Deposits",
      "queryLines": [
        "select sum(total_balance) as total_deposits from banking.gold.customer_360;"
      ]
    },
    {
      "name": "20d1c49e",
      "displayName": "Total Transactions",
      "queryLines": [
        "select sum(total_transactions) as total_transaction\r\n",
        "from banking.gold.customer_360;"
      ]
    },
    {
      "name": "23bb1aac",
      "displayName": "High Risk customers",
      "queryLines": [
        "select count(*) as high_risk_customers from banking.gold.customer_360 where risk_grade='HIGH';"
      ]
    },
    {
      "name": "1400fc6c",
      "displayName": "Customer Segment Distribution",
      "queryLines": [
        "select customer_segment, count(*)\r\n",
        "as customers from banking.gold.customer_360\r\n",
        "group by customer_segment;"
      ]
    },
    {
      "name": "b5fd0386",
      "displayName": "Credit Risk Distribution",
      "queryLines": [
        "select risk_grade, count(*) as customers\r\n",
        "from banking.gold.customer_360 group by risk_grade;"
      ]
    },
    {
      "name": "efa0845d",
      "displayName": "Gateway Transaction Summary",
      "queryLines": [
        "select\n",
        "  gateway_name,\n",
        "  sum(successful_transactions) as successful_transactions,\n",
        "  sum(failed_transactions) as failed_transactions\n",
        "from\n",
        "  banking.gold.transaction_channel_summary\n",
        "group by\n",
        "  gateway_name;"
      ]
    },
    {
      "name": "16787c1c",
      "displayName": "Branch Deposit",
      "queryLines": [
        "select branch_name, total_deposits\r\n",
        "from banking.gold.branch_performance \r\n",
        "order by total_deposits desc;"
      ]
    },
    {
      "name": "cc1c9bfd",
      "displayName": "Branch Customers",
      "queryLines": [
        "select branch_name, total_customers\r\n",
        "from banking.gold.branch_performance \r\n",
        "order by total_customers desc;"
      ]
    },
    {
      "name": "ae8aa6a1",
      "displayName": "Branch Transactions",
      "queryLines": [
        "select\n",
        "  branch_name,\n",
        "  total_transactions\n",
        "from\n",
        "  banking.gold.branch_performance\n",
        "order by\n",
        "  total_transactions desc;"
      ]
    },
    {
      "name": "516f172d",
      "displayName": "Gateway Source Transactions",
      "queryLines": [
        "select gateway_name, count(successful_transactions) as successful_transactions, count(failed_transactions) as failed_transactions from banking.gold.transaction_channel_summary group by gateway_name;"
      ]
    },
    {
      "name": "f2179169",
      "displayName": "Device Type Transactions",
      "queryLines": [
        "select device_type, count(successful_transactions) as successful_transactions, count(failed_transactions) as failed_transactions from banking.gold.transaction_channel_summary group by device_type;"
      ]
    },
    {
      "name": "top_customers",
      "displayName": "Top Customers",
      "config": {
        "version": "1.1",
        "source": "SELECT customer_name, branch_name, total_balance FROM banking.gold.customer_360 ORDER BY total_balance DESC LIMIT 10\n",
        "comment": "Top 10 customers by total balance",
        "dimensions": [
          {
            "name": "customer_name",
            "expr": "customer_name",
            "displayName": "Customer"
          },
          {
            "name": "branch_name",
            "expr": "branch_name",
            "displayName": "Branch"
          },
          {
            "name": "total_balance",
            "expr": "total_balance",
            "displayName": "Total Balance",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    }
  ],
